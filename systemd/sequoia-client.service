[Unit]
Description=Sequoia Client — gRPC daemon for IV&V hardware validation
Documentation=https://github.com/SiliconCentric/Sequoia-Client
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5 [Service]
Type=simple
User=sequoia
Group=sequoia
WorkingDirectory=/var/lib/sequoia
# Starts BOTH listeners:
# - ClientService (stream path → Server, default port 50051)
# - HalService (SDK/E2E path, default port 50052)
ExecStart=/usr/bin/sequoia-client
Restart=on-failure
RestartSec=5 # Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sequoia-client # Hardening
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
ReadWritePaths=/var/lib/sequoia
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes [Install]
WantedBy=multi-user.target
